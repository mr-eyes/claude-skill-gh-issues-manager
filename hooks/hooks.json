{
  "description": "Inject the project's record brief from GitHub issues: at session start, resume, clear, compaction and fork; into every subagent; as one line on user prompts when it changed; and as instructions for the compaction summary. Silent unless the project has a .gh-issues-manager.json file and the user has trusted its repository.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/gh-issues-manager/scripts/session_start_hook.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/gh-issues-manager/scripts/run_hook.sh subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/gh-issues-manager/scripts/run_hook.sh prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/skills/gh-issues-manager/scripts/run_hook.sh pre-compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
