{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/session_start_hook.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_hook.sh\" subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_hook.sh\" prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_hook.sh\" pre-compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
